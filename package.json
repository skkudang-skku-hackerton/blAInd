{
  "name": "blaind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wxt",
    "test": "vitest run && npm run test:node",
    "test:node": "node --experimental-strip-types --test --experimental-test-isolation=none tests/unit/text-submit-interceptor.test.mjs",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "build": "npm run build:chrome && npm run build:firefox && npm run build:safari",
    "build:release": "npm run typecheck && npm test && npm run build",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:safari": "wxt zip -b safari",
    "zip": "npm run zip:chrome && npm run zip:firefox && npm run zip:safari",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:firefox": "playwright test --project=firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "mupdf": "1.28.1",
    "onnxruntime-web": "1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "linkedom": "0.18.13",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
